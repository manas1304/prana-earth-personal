// =============================================================================
// MARKETPLACE PROJECTS
// =============================================================================

model Project {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  title       String  @db.VarChar(255)
  slug        String  @unique @db.VarChar(255)
  description String?
  location    String? @db.VarChar(255)
  country     String? @db.VarChar(100)

  projectType   String? @map("project_type") @db.VarChar(100)
  sector        String? @db.VarChar(100)
  fundingTarget Decimal? @map("funding_target") @db.Decimal(18, 2)
  currency      String?  @db.VarChar(10)
  returnRate    Decimal? @map("return_rate") @db.Decimal(5, 2)
  tenure        Int?     // in months

  thumbnailUrl String? @map("thumbnail_url") @db.Text
  bannerUrl    String? @map("banner_url") @db.Text
  /// Public concept-note document URL (PDF) — for marketplace gated download
  conceptNoteUrl     String?   @map("concept_note_url") @db.Text
  /// Structured project milestones timeline (JSON array)
  milestones        Json?     @map("milestones")
  /// AI-generated recommendations shown on the project detail page
  recommendations   Json?     @map("recommendations")
  /// Short-horizon forecast (e.g. 12-month outlook)
  forecast          Json?     @map("forecast")
  tags         String[]

  status           ProjectStatus?           @default(UPCOMING)
  visibility       ProjectVisibility?       @default(PUBLIC)
  approvalStatus   ProjectApprovalStatus?   @default(DRAFT) @map("approval_status")

  organizationId String? @map("organization_id") @db.Uuid
  metadata       Json?

  publishedAt DateTime? @map("published_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  // Relations
  organization    Organization?     @relation(fields: [organizationId], references: [id])
  savedBy         SavedProject[]
  dprRequests     DPRRequest[]
  expressInterests ExpressInterest[]
  messageThreads  MessageThread[]

  @@index([status])
  @@index([approvalStatus])
  @@index([visibility])
  @@index([createdAt])
  @@map("projects")
}

// =============================================================================
// SAVED PROJECTS
// =============================================================================

model SavedProject {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  userId    String @map("user_id") @db.Uuid
  projectId String @map("project_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@map("saved_projects")
}

// =============================================================================
// DPR REQUESTS (DETAILED PROJECT REPORT)
// =============================================================================

model DPRRequest {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  userId    String @map("user_id") @db.Uuid
  projectId String @map("project_id") @db.Uuid

  message  String?
  status   String? @default("PENDING") @db.VarChar(50)
  metadata Json?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz

  // Relations
  user    User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id])
  messageThreads MessageThread[]

  @@index([userId])
  @@index([projectId])
  @@index([status])
  @@map("dpr_requests")
}

// =============================================================================
// EXPRESS INTERESTS
// =============================================================================

model ExpressInterest {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  userId    String @map("user_id") @db.Uuid
  projectId String @map("project_id") @db.Uuid

  investmentAmount Decimal? @map("investment_amount") @db.Decimal(18, 2)
  message          String?
  status           InterestStatus? @default(NEW)

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz

  // Relations
  user    User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id])

  @@index([userId])
  @@index([projectId])
  @@index([status])
  @@map("express_interests")
}

// =============================================================================
// CONTACT SUBMISSIONS
// =============================================================================

model ContactSubmission {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  userId String? @map("user_id") @db.Uuid

  fullName String  @map("full_name") @db.VarChar(255)
  email    String  @db.VarChar(255)
  phone    String? @db.VarChar(30)
  /// First-class columns so the admin leads page can show them
  /// without parsing the metadata JSON blob. Existing rows that
  /// have only `metadata.company` / `metadata.role` continue to
  /// work — the service reads from metadata as a fallback.
  company  String? @db.VarChar(255)
  role     String? @db.VarChar(255)
  subject  String? @db.VarChar(255)
  message  String

  status    String?  @default("UNREAD") @db.VarChar(50)
  /// Distinguishes the source surface so the admin can filter
  /// "marketplace-contact" vs "predict-contact" vs others.
  source    String?  @db.VarChar(100)
  metadata  Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user User? @relation(fields: [userId], references: [id])

  @@index([email])
  @@index([status])
  @@index([source])
  @@index([createdAt])
  @@map("contact_submissions")
}

// =============================================================================
// SYSTEM EVENTS
// =============================================================================

model SystemEvent {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  eventName     String? @map("event_name") @db.VarChar(255)
  aggregateType String? @map("aggregate_type") @db.VarChar(100)
  aggregateId   String? @map("aggregate_id") @db.Uuid
  payload       Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([eventName])
  @@index([createdAt])
  @@map("system_events")
}

// =============================================================================
// IMPLEMENTATION PARTNERS
// =============================================================================

model ImplementationPartner {
  id        String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  /// Auto-generated readable ID, e.g. PRT-2024-01A
  partnerId String? @unique @map("partner_id") @db.VarChar(50)

  name         String           @db.VarChar(255)
  type         PartnerType?
  websiteUrl   String?          @map("website_url") @db.Text
  logoUrl      String?          @map("logo_url") @db.Text
  region       String?          @db.VarChar(255)
  country      String?          @db.VarChar(100)
  /// Tax / registration ID captured in the partner edit modal
  taxId        String?          @map("tax_id") @db.VarChar(100)

  /// Array of capabilities/expertise tags (preset + custom)
  capabilities String[]

  activeProjects Int?    @default(0) @map("active_projects")
  totalImpact    String? @map("total_impact") @db.VarChar(100)

  status ImplementationPartnerStatus @default(UNDER_REVIEW)

  createdById String? @map("created_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  // Relations
  createdBy User? @relation("PartnerCreatedBy", fields: [createdById], references: [id])

  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("implementation_partners")
}

// =============================================================================
// USER NOTIFICATION PREFERENCES
// =============================================================================

model NotificationPreference {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  userId String @map("user_id") @db.Uuid

  /// Master email toggle (overrides per-channel when false)
  emailEnabled Boolean @default(true) @map("email_enabled")
  inAppEnabled Boolean @default(true) @map("in_app_enabled")

  /// Per-event-type channels: { type: { email: bool, inApp: bool, sms: bool } }
  items Json?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@map("notification_preferences")
}

// =============================================================================
// MARKETPLACE MESSAGING (user ↔ project owner)
// =============================================================================

model MessageThread {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  /// A thread is anchored on a project (DPR or general enquiry)
  projectId String? @map("project_id") @db.Uuid
  /// Optional anchor to a DPR request
  dprRequestId String? @map("dpr_request_id") @db.Uuid

  subject String? @db.VarChar(255)

  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  project     Project?      @relation(fields: [projectId], references: [id])
  dprRequest  DPRRequest?   @relation(fields: [dprRequestId], references: [id])
  participants MessageParticipant[]
  messages     Message[]

  @@index([projectId])
  @@index([dprRequestId])
  @@index([lastMessageAt])
  @@map("message_threads")
}

model MessageParticipant {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  threadId String @map("thread_id") @db.Uuid
  userId  String @map("user_id") @db.Uuid

  role String? @default("MEMBER") @db.VarChar(50) // OWNER | MEMBER | ADMIN
  lastReadAt DateTime? @map("last_read_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@map("message_participants")
}

model Message {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  threadId String @map("thread_id") @db.Uuid
  senderId String @map("sender_id") @db.Uuid

  body       String
  attachments Json?
  readAt    DateTime? @map("read_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User          @relation("MessagesSent", fields: [senderId], references: [id])

  @@index([threadId, createdAt])
  @@map("messages")
}

// =============================================================================
// HELP & SUPPORT
// =============================================================================

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  @@map("ticket_status")
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
  @@map("ticket_priority")
}

model HelpCategory {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  name        String  @unique @db.VarChar(100)
  slug        String  @unique @db.VarChar(100)
  description String?
  icon        String? @db.VarChar(50)
  sortOrder   Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  articles HelpArticle[]
  faqs     HelpFaq[]

  @@map("help_categories")
}

model HelpArticle {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  categoryId String? @map("category_id") @db.Uuid

  title       String  @db.VarChar(255)
  slug        String  @unique @db.VarChar(255)
  excerpt     String? @db.VarChar(500)
  body        String?
  readTimeMin Int?    @map("read_time_min")
  viewCount   Int     @default(0) @map("view_count")

  isPublished Boolean @default(false) @map("is_published")
  isFeatured  Boolean @default(false) @map("is_featured")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  category HelpCategory? @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([isPublished])
  @@map("help_articles")
}

model HelpFaq {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  categoryId String? @map("category_id") @db.Uuid

  question String
  answer   String
  sortOrder Int    @default(0) @map("sort_order")

  isPublished Boolean @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  category HelpCategory? @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@map("help_faqs")
}

model SupportTicket {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  userId String? @map("user_id") @db.Uuid

  subject     String         @db.VarChar(255)
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)

  attachments Json?

  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user User? @relation("TicketsRaised", fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("support_tickets")
}

// =============================================================================
// ORGANIZATION-LEVEL FEEDBACK / IMPACT METRICS
// =============================================================================

model SustainabilityImpact {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  /// Snapshot key e.g. "global" or "organization:<id>"
  scope String @unique @db.VarChar(100)

  carbonSavedTons    Decimal? @map("carbon_saved_tons") @db.Decimal(18, 2)
  waterConservedTons Decimal? @map("water_conserved_tons") @db.Decimal(18, 2)
  hectaresRestored   Decimal? @map("hectares_restored") @db.Decimal(18, 2)
  beneficiaries      Int?

  /// Free-form metric blobs so the dashboard can render new KPIs without migration
  metrics Json?

  asOf DateTime? @map("as_of") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  @@map("sustainability_impact")
}
